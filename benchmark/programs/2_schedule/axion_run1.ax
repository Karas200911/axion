input total: text
input n: number
input start: text

function pad2(v: number) -> text
  p = if v < 10 then "0" else ""
  return p + v as text
end

function dim(y: number, m: number) -> number
  result = 31
  if m == 2
    leap = (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
    if leap
      result = 29
    else
      result = 28
    end
  else if m == 4 or m == 6 or m == 9 or m == 11
    result = 30
  end
  return result
end

if n < 1
  print "error: n must be 1 or more"
  exit
end
tn = total as number
if tn < 0
  print "error: total must not be negative"
  exit
end
cents = tn * 100
if cents != cents floor
  print "error: total has fractions of a kopeck"
  exit
end
base = cents // n
extra = cents % n
parts = start split "-"
y = parts[0] as number
m = parts[1] as number
d = parts[2] as number
for i in 0 to n - 1
  amt = base + (if i < extra then 1 else 0)
  whole = amt // 100
  fr = amt % 100
  s = whole as text + "." + pad2(fr)
  while s length < 9
    s = " " + s
  end
  mi = y * 12 + (m - 1) + i
  yy = mi // 12
  mm = mi % 12 + 1
  dm = dim(yy, mm)
  dd = if d < dm then d else dm
  line = "  " + yy as text + "-" + pad2(mm) + "-" + pad2(dd) + s
  print line
end
