input total: text
input n: number
input start: text

function dim(y: number, m: number) -> number
  if m == 2
    leap = (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
    if leap
      return 29
    end
    return 28
  end
  if m == 4 or m == 6 or m == 9 or m == 11
    return 30
  end
  return 31
end

function two(v: number) -> text
  pad = if v < 10 then "0" else ""
  return pad + v as text
end

t = total as number
cents = t * 100
if n < 1
  print "error: n must be 1 or more"
  exit
end
if t < 0
  print "error: total must not be negative"
  exit
end
if cents != cents floor
  print "error: total has fractions of a kopeck"
  exit
end

share = cents // n
extra = cents % n
y = start[0 to 3] as number
m = start[5 to 6] as number
d = start[8 to 9] as number

for i in 0 to n - 1
  c = share
  if i < extra
    c = c + 1
  end
  mm = m - 1 + i
  yy = y + mm // 12
  mo = mm % 12 + 1
  last = dim(yy, mo)
  day = if d < last then d else last
  date = yy as text + "-" + two(mo) + "-" + two(day)
  whole = c // 100
  frac = c % 100
  amt = whole as text + "." + two(frac)
  while amt length < 9
    amt = " " + amt
  end
  line = "  " + date + amt
  print line
end
