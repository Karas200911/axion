input lines: list of text
function prec(op: text) -> number
  if op == "+" or op == "-"
    return 1
  else if op == "*" or op == "/"
    return 2
  else if op == "u"
    return 3
  end
  return 4
end

function calc(op: text, a: number, b: number) -> number
  if op == "+"
    return a + b
  else if op == "-"
    return a - b
  else if op == "*"
    return a * b
  else if op == "/"
    return a / b
  end
  return a ** b
end

for line in lines
  n = line length
  err = ""
  tk = [] of text
  tp = [] of number
  i = 0
  while i < n
    ch = line[i]
    if ch == " "
      i = i + 1
    else if "0123456789." contains ch
      start = i
      numtxt = ""
      while i < n
        c2 = line[i]
        if "0123456789." contains c2
          numtxt = numtxt + c2
          i = i + 1
        else
          break
        end
      end
      tk add numtxt
      tp add start + 1
    else if "+-*/^()" contains ch
      tk add ch
      tp add i + 1
      i = i + 1
    else
      err = "ошибка: неизвестный символ '" + ch + "', позиция " + (i + 1) as text
      break
    end
  end
  if err == "" and tk length == 0
    err = "ошибка: пустое выражение"
  end
  result = ""
  if err == ""
    tk add "$"
    tp add n + 1
    vals = [] of number
    ops = [] of text
    expect = true
    tn = tk length
    for j in 0 to tn - 1
      if err != ""
        break
      end
      t = tk[j]
      p = tp[j]
      isnum = "0123456789." contains t[0]
      if expect
        if isnum
          if t is number
            vals add t as number
            expect = false
          else
            err = "ошибка: ожидалось число, позиция " + p as text
          end
        else if t == "("
          ops add "("
        else if t == "-"
          ops add "u"
        else
          err = "ошибка: ожидалось число, позиция " + p as text
        end
      else
        thresh = 0
        if t == "+" or t == "-"
          thresh = 1
        else if t == "*" or t == "/"
          thresh = 2
        else if t == "^"
          thresh = 5
        else if t == ")" or t == "$"
          thresh = 0
        else
          err = "ошибка: ожидалось число, позиция " + p as text
        end
        if err == ""
          while ops length > 0
            top = ops[ops length - 1]
            if top == "("
              break
            end
            if prec(top) < thresh
              break
            end
            ti = ops length - 1
            ops remove index ti
            vi = vals length - 1
            if top == "u"
              a = vals[vi]
              vals[vi] = 0 - a
            else
              b = vals[vi]
              vals remove index vi
              vj = vals length - 1
              a = vals[vj]
              if top == "/" and b == 0
                err = "ошибка: деление на ноль"
                break
              end
              vals[vj] = calc(top, a, b)
            end
          end
        end
        if err == ""
          if t == ")"
            if ops length == 0
              err = "ошибка: ожидалось число, позиция " + p as text
            else
              oi = ops length - 1
              ops remove index oi
            end
          else if t == "$"
            if ops length > 0
              err = "ошибка: не закрыта скобка"
            end
          else
            ops add t
            expect = true
          end
        end
      end
    end
    if err == ""
      result = vals[0] as text
    end
  end
  if err != ""
    print err
  else
    print result
  end
end
